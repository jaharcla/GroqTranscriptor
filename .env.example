NOTION_TOKEN=
# Set either the Lecture Inbox database ID or its data source ID.
NOTION_DATABASE_ID=
NOTION_DATA_SOURCE_ID=
TRANSCRIPT_DIR=C:/CourseAI/Lectures/Transcripts
AUDIO_DIR=C:/CourseAI/Lectures/Audio Inbox
ARCHIVE_DIR=C:/CourseAI/Lectures/Archive
STATE_DB=C:/CourseAI/Lectures/bridge-state.sqlite3
LOG_FILE=C:/CourseAI/Lectures/bridge.log
COURSE_MAP=courses.yaml
STABLE_SECONDS=5
STABLE_TIMEOUT=300
RETRY_SECONDS=30
ARCHIVE_AUDIO=false
# Exact Notion property names; these can be renamed here.
PROP_LECTURE=Lecture
PROP_COURSE=Course
PROP_DATE=Date
PROP_CAPTURE=Capture method
PROP_PROCESSING=Processing
PROP_LOCAL_PATH=Local transcript path
PROP_INGEST_ID=Ingest ID

# Groq reviews text before upload. Both Groq and Notion credentials are required.
# KEEP your existing working Notion settings; append this section to your .env.
GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
REVIEW_DIR=reviews
# Optional COURSE.md files with sourced course terminology, e.g. KIN120.md.
REVIEW_CONTEXT_DIR=review-context

# Random filenames use this course. Change it before importing another course.
ACTIVE_COURSE=KIN120
# Optional YYYY-MM-DD override for older recordings; otherwise source file modified date.
LECTURE_DATE=

# Direct saved audio -> Groq transcription -> Groq review -> Notion. No Buzz needed.
GROQ_AUDIO_ENABLED=true
GROQ_AUDIO_MODEL=whisper-large-v3
AUDIO_CACHE_DIR=audio-cache
